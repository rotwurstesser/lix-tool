{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LIX Writer",
  "version": "0.1.0",
  "identifier": "ch.rotwurstesser.lixwriter",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run fetch-ollama && npm run dev",
    "beforeBuildCommand": "npm run fetch-ollama && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LIX Writer",
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "resources/ollama/": "ollama/"
    }
  }
}
